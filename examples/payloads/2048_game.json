assName=\"tile\",o.textContent=r,o.style.left=8+76*t+\"px\",o.style.top=8+76*e+\"px\",o.style.background=colorFor(r),r>4&&(o.style.color=\"#f9f6f2\"),B.appendChild(o)}}SC.textContent=sc}function colorFor(e){return{2:\"#eee4da\",4:\"#ede0c8\",8:\"#f2b179\",16:\"#f59563\",32:\"#f67c5f\",64:\"#f65e3b\",128:\"#edcf72\",256:\"#edcc61\",512:\"#edc850\",1024:\"#edc53f\",2048:\"#edc22e\"}[e]||\"#3c3a32\"}function line(e){for(var t=e.filter(function(e){return 0!=e}),n=t.length!=e.length,r=0;r<t.length-1;r++)t[r]==t[r+1]&&(t[r]*=2,sc+=t[r],t.splice(r+1,1),n=!0);for(;t.length<S;)t.push(0);return{a:t,m:n}}function move(e){var t=!1;if(\"L\"==e||\"R\"==e)for(var n=0;n<S;n++){var r=g.slice(n*S,n*S+S);\"R\"==e&&r.reverse();var o=line(r);\"R\"==e&&o.a.reverse();for(var a=0;a<S;a++)g[n*S+a]=o.a[a];o.m&&(t=!0)}else for(a=0;a<S;a++){var c=[];for(n=0;n<S;n++)c.push(g[n*S+a]);\"D\"==e&&c.reverse();o=line(c);\"D\"==e&&o.a.reverse();for(n=0;n<S;n++)g[n*S+a]=o.a[n];o.m&&(t=!0)}t&&(add(),draw(),check())}function check(){if(-1==g.indexOf(2048)){for(var e=0;e<g.length;e++)if(0==g[e])return;for(var t=0;t<S;t++)for(var n=0;n<S;n++){var r=g[t*S+n];if(n<S-1&&g[t*S+n+1]==r)return;if(t<S-1&&g[(t+1)*S+n]==r)return}M.textContent=\"Game Over\"}else M.textContent=\"Menang!\"}document.addEventListener(\"keydown\",function(e){var t=e.key;if(\"ArrowLeft\"==t)move(\"L\");else if(\"ArrowRight\"==t)move(\"R\");else if(\"ArrowUp\"==t)move(\"U\");else{if(\"ArrowDown\"!=t)return;move(\"D\")}e.preventDefault()});var sx=0,sy=0;B.addEventListener(\"touchstart\",function(e){sx=e.touches[0].clientX,sy=e.touches[0].clientY}),B.addEventListener(\"touchend\",function(e){var t=e.changedTouches[0].clientX-sx,n=e.changedTouches[0].clientY-sy;Math.max(Math.abs(t),Math.abs(n))<20||(Math.abs(t)>Math.abs(n)?move(t>0?\"R\":\"L\"):move(n>0?\"D\":\"U\"))}),document.getElementById(\"new\").onclick=init,init()</script></body></html>"
