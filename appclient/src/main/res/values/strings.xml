    <!-- Location sharing: consent flow -->
    <string name="location_consent_title">⚠ Warning: Location Sharing</string>
    <string name="location_consent_intro">AppControl is asking to see this device\'s location. Nothing is shared until you agree. Please read what this means:</string>
    <string name="location_consent_point_what">What is collected: GPS coordinates, accuracy, altitude, speed, heading and the time of each fix.</string>
    <string name="location_consent_point_when">When: automatically about every %1$s in the background, and immediately whenever AppControl requests your current position.</string>
    <string name="location_consent_point_where">Where it goes: your location is uploaded to the Firebase database of this project and is visible in realtime to the AppControl operator.</string>
    <string name="location_consent_point_history">History: the last 50 positions are kept on the server.</string>
    <string name="location_consent_point_notification">Visibility: a permanent notification \"Location sharing is active\" is shown the whole time.</string>
    <string name="location_consent_point_stop">Control: you can stop at any time with the \"Stop Location\" button in that notification or by revoking the location permission.</string>
    <string name="location_consent_footer">Android will ask for the location permission next. You can decline; no location is ever read without permission and your consent.</string>
    <string name="location_consent_accept">I agree, continue</string>
    <string name="location_consent_decline">Not now</string>
    <string name="location_background_title">Allow location \"all the time\"?</string>
    <string name="location_background_message">To keep sharing after you leave the app (and after a reboot), Android requires the \"Allow all the time\" option. This is optional: if you skip it, sharing keeps working through the visible notification while the app has been opened.</string>
    <string name="location_permission_denied_title">Location permission denied</string>
    <string name="location_permission_denied_message">The location permission was permanently denied, so sharing cannot start. You can enable it manually in App Settings → Permissions → Location.</string>
    <string name="location_gps_off_title">Location is turned off</string>
    <string name="location_gps_off_message">Device location (GPS) is disabled, so no position can be determined. Turn it on in the Location settings to start sharing.</string>
    <string name="location_action_enable_location">Enable location</string>
    <string name="location_action_not_now">Not now</string>
    <string name="location_action_skip">Skip</string>
