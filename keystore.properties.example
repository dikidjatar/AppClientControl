# Copy this file to keystore.properties (which is git-ignored) and fill in real values.
# keystore.properties is read by both appclient/build.gradle.kts and appcontrol/build.gradle.kts
# at build time. If the file is absent, the debug signing key is used for release builds.

storeFile=path/to/your/release.keystore
storePassword=your_keystore_password
keyAlias=your_key_alias
keyPassword=your_key_password
